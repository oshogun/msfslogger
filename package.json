{
  "name": "msfslogger",
  "version": "1.0.0",
  "description": "MSFS 2024 flight logger with web interface",
  "main": "dist/index.js",
  "scripts": {
    "dev:server": "ts-node src/index.ts",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "cd client && npm run build",
    "build:server": "tsc",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/index.js",
    "backfill-icao": "ts-node src/backfill-icao.ts"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "express": "^4.18.3",
    "multer": "^2.2.0",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^24.43.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.11.20",
    "concurrently": "^8.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
